exports/
results/

# Keep only TeX source files inside tex/ (plus figures under tex/images/)
tex/**
!tex/**/
!tex/**/*.tex
!tex/**/*.bib
!tex/images/**/*.pdf
!tex/images/**/*.png
!tex/.gitignore
!tex/.gitlab-ci.yml

# OS
.DS_Store
Thumbs.db

# Ignore hidden files/directories generically
.*
!.gitignore
